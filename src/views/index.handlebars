<!-- Thẻ thông tin kiến trúc Cloud -->
<div class="metrics-grid">
  <div class="metric-card">
    <div class="card-icon">🔐</div>
    <div class="card-content">
      <span class="card-title">Bảo Mật Least Privilege</span>
      <p class="card-desc">02 tài khoản độc lập: <strong>Read-Only</strong> (Xem) & <strong>Read-Write</strong> (Thêm
        mới)</p>
    </div>
  </div>
  <div class="metric-card">
    <div class="card-icon">⚡</div>
    <div class="card-content">
      <span class="card-title">Stateless Session</span>
      <p class="card-desc">Lưu tập trung tại <strong>Cloud MongoDB Atlas</strong> (connect-mongo, không lưu RAM)</p>
    </div>
  </div>
  <div class="metric-card">
    <div class="card-icon">🎯</div>
    <div class="card-content">
      <span class="card-title">Bộ Lọc & Thuế VAT</span>
      <p class="card-desc">Tiền tố mã: <strong>{{requiredPrefix}}</strong> | Thuế suất: <strong>{{vatRate}}%</strong>
      </p>
    </div>
  </div>
</div>

<!-- Session Info Badge -->
{{#if sessionData}}
<div class="session-box">
  <div class="session-header">
    <span class="pulse-icon"></span>
    <span><strong>Stateless Session Active:</strong> ID <code>{{sessionData.id}}</code></span>
  </div>
  <div class="session-detail">
    <span>Số lần truy cập trong phiên: <strong>{{sessionData.views}}</strong></span>
    <span class="tag-cloud">Lưu trữ: MongoDB Atlas Cluster0</span>
  </div>
</div>
{{/if}}

<!-- Thông báo lỗi hoặc thành công -->
{{#if errorMessage}}
<div class="alert alert-danger" role="alert">
  <div class="alert-icon">⚠️</div>
  <div class="alert-body">
    <strong>LỖI XỬ LÝ:</strong> {{errorMessage}}
  </div>
</div>
{{/if}}

{{#if successMessage}}
<div class="alert alert-success" role="alert">
  <div class="alert-icon">✅</div>
  <div class="alert-body">
    <strong>THÀNH CÔNG:</strong> {{successMessage}}
  </div>
</div>
{{/if}}

<!-- Form Thêm Sách Mới (Luồng Write) -->
<section class="card section-card">
  <div class="section-header">
    <h2>➕ Thêm Sách Mới (Ghi dữ liệu qua Write Account)</h2>
    <span class="badge-role write-role">Write Pool Access</span>
  </div>
  <form action="/books" method="POST" class="book-form">
    <div class="form-grid">
      <div class="form-group">
        <label for="bookCode">
          Mã sản phẩm / Sách <span class="required">*</span>
          <span class="hint-tag">Bắt buộc bắt đầu bằng "{{requiredPrefix}}"</span>
        </label>
        <input type="text" id="bookCode" name="bookCode" placeholder="Ví dụ: {{requiredPrefix}}-BK01" required
          autocomplete="off">
      </div>

      <div class="form-group">
        <label for="title">Tên sách <span class="required">*</span></label>
        <input type="text" id="title" name="title" placeholder="Nhập tên sách..." required autocomplete="off">
      </div>

      <div class="form-group">
        <label for="author">Tác giả <span class="required">*</span></label>
        <input type="text" id="author" name="author" placeholder="Nhập tên tác giả..." required autocomplete="off">
      </div>

      <div class="form-group">
        <label for="price">Giá gốc (VNĐ) <span class="required">*</span></label>
        <input type="number" id="price" name="price" placeholder="Ví dụ: 100000" min="0" step="1000" required>
        <small class="form-help">Hệ thống sẽ tự tính giá sau thuế với mức VAT = {{vatRate}}%</small>
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">
        <span>Lưu Sách Vào Cloud MongoDB</span> 🚀
      </button>
    </div>
  </form>
</section>

<!-- Danh sách Sách (Luồng Read) -->
<section class="card section-card">
  <div class="section-header">
    <h2>📚 Danh Sách Sách (Đọc dữ liệu qua Read-Only Account)</h2>
    <div class="header-right">
      <span class="badge-role read-role">Read Pool Access</span>
      <span class="counter-badge">Tổng: {{books.length}} cuốn</span>
    </div>
  </div>

  {{#if books.length}}
  <div class="table-responsive">
    <table class="book-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Mã Sách</th>
          <th>Tên Sách</th>
          <th>Tác Giả</th>
          <th>Giá Gốc</th>
          <th>VAT</th>
          <th>Giá Sau Thuế</th>
          <th>Thời Gian Tạo</th>
          <th style="text-align: center;">Thao Tác</th>
        </tr>
      </thead>
      <tbody>
        {{#each books}}
        <tr>
          <td>{{@index}}</td>
          <td><code class="code-badge">{{this.bookCode}}</code></td>
          <td class="font-semibold">{{this.title}}</td>
          <td>{{this.author}}</td>
          <td>{{this.price}} VNĐ</td>
          <td><span class="vat-tag">+{{this.vatRate}}%</span></td>
          <td><strong class="price-highlight">{{this.priceWithVAT}} VNĐ</strong></td>
          <td class="text-muted">{{this.createdAt}}</td>
          <td style="text-align: center;">
            <div class="action-buttons">
              <button 
                type="button" 
                class="btn-action btn-edit" 
                onclick="openEditModal('{{this._id}}', '{{this.bookCode}}', '{{this.title}}', '{{this.author}}', '{{this.price}}')"
                title="Chỉnh sửa sách"
              >
                ✏️ Sửa
              </button>
              <form 
                action="/books/delete/{{this._id}}" 
                method="POST" 
                style="display: inline;" 
                onsubmit="return confirm('Bạn có chắc chắn muốn xóa cuốn sách \'{{this.title}}\' khỏi Cloud MongoDB Atlas?');"
              >
                <button type="submit" class="btn-action btn-delete" title="Xóa sách">
                  🗑️ Xóa
                </button>
              </form>
            </div>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{else}}
  <div class="empty-state">
    <div class="empty-icon">📖</div>
    <h3>Chưa có sách nào trong cơ sở dữ liệu</h3>
    <p>Hãy thêm sách mới ở form trên để kiểm tra tính năng ghi dữ liệu và tính thuế VAT!</p>
  </div>
  {{/if}}
</section>

<!-- Modal Chỉnh Sửa Sách (Ghi qua Write Account) -->
<div id="editModal" class="modal-backdrop" style="display: none;">
  <div class="modal-card">
    <div class="modal-header">
      <div class="modal-title-box">
        <h3>✏️ Chỉnh Sửa Thông Tin Sách</h3>
        <span class="badge-role write-role">Write Pool Access</span>
      </div>
      <button type="button" class="modal-close" onclick="closeEditModal()">&times;</button>
    </div>
    <form id="editForm" method="POST" class="book-form">
      <div class="form-grid">
        <div class="form-group">
          <label for="editBookCode">
            Mã sản phẩm / Sách <span class="required">*</span>
            <span class="hint-tag">Tiền tố: {{requiredPrefix}}</span>
          </label>
          <input type="text" id="editBookCode" name="bookCode" required autocomplete="off">
        </div>

        <div class="form-group">
          <label for="editTitle">Tên sách <span class="required">*</span></label>
          <input type="text" id="editTitle" name="title" required autocomplete="off">
        </div>

        <div class="form-group">
          <label for="editAuthor">Tác giả <span class="required">*</span></label>
          <input type="text" id="editAuthor" name="author" required autocomplete="off">
        </div>

        <div class="form-group">
          <label for="editPrice">Giá gốc (VNĐ) <span class="required">*</span></label>
          <input type="number" id="editPrice" name="price" min="0" step="1000" required>
          <small class="form-help">Hệ thống sẽ tự tính lại giá sau thuế (+{{vatRate}}% VAT)</small>
        </div>
      </div>

      <div class="modal-actions">
        <button type="button" class="btn btn-secondary" onclick="closeEditModal()">Hủy</button>
        <button type="submit" class="btn btn-primary">Lưu Thay Đổi (Cloud)</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openEditModal(id, bookCode, title, author, price) {
    document.getElementById('editForm').action = '/books/edit/' + id;
    document.getElementById('editBookCode').value = bookCode;
    document.getElementById('editTitle').value = title;
    document.getElementById('editAuthor').value = author;
    document.getElementById('editPrice').value = price;
    document.getElementById('editModal').style.display = 'flex';
  }

  function closeEditModal() {
    document.getElementById('editModal').style.display = 'none';
  }

  window.onclick = function(event) {
    const modal = document.getElementById('editModal');
    if (event.target === modal) {
      closeEditModal();
    }
  };
</script>